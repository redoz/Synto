<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="github" value="https://nuget.pkg.github.com/redoz/index.json" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!-- Central package management with >1 source requires every source be mapped (NU1507). Every
         package this repo restores lives on nuget.org; the github feed is the Synto publish target
         (see packageSourceCredentials below), so only Synto* is mapped to it. -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="Synto*" />
        </packageSource>
    </packageSourceMapping>
    <packageSourceCredentials>
        <github>
            <add key="Username" value="redoz" />
            <add key="ClearTextPassword" value="%GITHUB_PAT%" />
        </github>
    </packageSourceCredentials>
</configuration>