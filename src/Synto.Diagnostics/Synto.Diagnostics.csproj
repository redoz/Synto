<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
	<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

	<!-- Synto.Diagnostics is no longer its own nupkg: it is one feature DLL bundled by the
	     Synto umbrella (src/Synto.Generators). It ships no package metadata of its own and is
	     resolved/packed by the umbrella's multi-assembly analyzer bundling. -->
	<IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
	<!-- The test project asserts incremental-cache step reasons and uses the internal TrackingNames. -->
	<InternalsVisibleTo Include="Synto.Diagnostics.Test" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Synto.GenKit\Synto.GenKit.csproj" />
	<ProjectReference Include="..\Synto.Incremental\Synto.Incremental.csproj" />
	<ProjectReference Include="..\Synto.Core\Synto.Core.csproj" PrivateAssets="all"/>
  </ItemGroup>

</Project>
