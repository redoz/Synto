<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<DebugType>embedded</DebugType>
		<DefineConstants>$(DefineConstants)TRACE;BOOTSTRAP</DefineConstants>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Synto.Core\Syntax\EmitHelpers\LiteralSyntaxExtensions.cs" Link="LiteralSyntaxExtensions.cs" />
		<Compile Include="..\Synto.Core\Emit\UsingDirectiveSet.cs" Link="UsingDirectiveSet.cs" />
		<Compile Include="..\Synto.Core\Formatting\SyntaxFormatter.cs" Link="SyntaxFormatter.cs" />
		<!-- The cacheability toolkit (EquatableArray / DiagnosticInfo / LocationInfo) is NOT copied here:
		     Bootstrap is the one sanctioned place that <Compile Link>s the generator's canonical pair
		     (namespace Synto.Generators), so the copy can never silently drift. Bootstrap never ships. -->
		<Compile Include="..\Synto.Generators\Incremental\EquatableArray.cs" Link="EquatableArray.cs" />
		<Compile Include="..\Synto.Generators\Incremental\DiagnosticInfo.cs" Link="DiagnosticInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- The test project asserts incremental-cache step reasons and uses the internal TrackingNames. -->
		<InternalsVisibleTo Include="Synto.Bootstrap.Test" />
	</ItemGroup>
</Project>
