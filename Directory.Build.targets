<Project>

  <!-- =============================================================================================
	   Shared packaging logic for Synto's Roslyn analyzer / source-generator NuGet packages.

	   A project opts in by setting <IsSyntoGeneratorPackage>true</IsSyntoGeneratorPackage>.

	   These packages ship their generator assembly (plus the small Synto runtime-helper assembly)
	   under analyzers/dotnet/cs so the C# compiler loads them at build time. Because the build
	   output is intentionally not a normal library (IncludeBuildOutput=false), NuGet's default pack
	   validation flags this layout; it is disabled for these analyzer packages only.

	   Synto.Core.dll is shipped ONLY under analyzers/dotnet/cs (an analysis-time dependency of the
	   generator). It is never a consumer runtime dependency: the consumer-facing surface is injected
	   as internal source by SurfaceInjectionGenerator, so consumers need no reference to Synto.Core.dll.

	   This file is imported by every project in the repo, so all logic is gated on
	   IsSyntoGeneratorPackage to leave the runtime lib, tests, and examples untouched.
	   ============================================================================================= -->

  <PropertyGroup Condition="'$(IsSyntoGeneratorPackage)' == 'true'">
	<!-- The compiler-loaded assemblies are packed by hand below, not as ordinary build output. -->
	<IncludeBuildOutput>false</IncludeBuildOutput>

	<!-- Only produce the .nupkg on Release builds to keep the Debug inner loop fast.
		 `dotnet pack` still works on demand in any configuration. -->
	<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>

	<!-- Analyzer packages legitimately place assemblies under analyzers/ while disabling normal
		 build output, which NuGet's pack analysis (NU5128 etc.) flags. The layout is deliberate,
		 so analysis is disabled for these packages only. -->
	<NoPackageAnalysis>true</NoPackageAnalysis>

	<!-- Shared package metadata -->
	<PackageProjectUrl>https://github.com/redoz/Synto</PackageProjectUrl>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<PackageTags>Roslyn;Syntax</PackageTags>
	<PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\</PackageOutputPath>
	<PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <!-- LICENSE + generator assembly + Synto helper assembly into analyzers/dotnet/cs -->
  <ItemGroup Condition="'$(IsSyntoGeneratorPackage)' == 'true'">
	<None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" Visible="false" PackagePath="\" />
	<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	<None Include="$(OutputPath)Synto.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Inject Synto.Core.dll alongside the analyzer so Roslyn resolves it when loading the generator. -->
  <PropertyGroup Condition="'$(IsSyntoGeneratorPackage)' == 'true'">
	<GetTargetPathDependsOn>$(GetTargetPathDependsOn);SyntoGetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="SyntoGetDependencyTargetPaths" Condition="'$(IsSyntoGeneratorPackage)' == 'true'">
	<ItemGroup>
	  <TargetPathWithTargetPlatformMoniker Include="$(MSBuildProjectDirectory)\$(OutputPath)Synto.Core.dll"
										   IncludeRuntimeDependency="false"
										   MSBuildSourceProjectFile="Synto.Core.csproj" />
	  <!-- Synto.GenKit.dll carries the injection mechanism (SurfaceInjectorBase); Roslyn must resolve it
		   alongside the generator when it loads a SurfaceInjector, or CS8032 results. Only generator
		   packages that opt in (SyntoBundlesGenKit=true, i.e. actually reference GenKit) surface it. -->
	  <TargetPathWithTargetPlatformMoniker Include="$(MSBuildProjectDirectory)\$(OutputPath)Synto.GenKit.dll"
										   Condition="'$(SyntoBundlesGenKit)' == 'true'"
										   IncludeRuntimeDependency="false"
										   MSBuildSourceProjectFile="Synto.GenKit.csproj" />

	  <!-- Synto.Incremental.dll carries the cacheable trio AND the lone IncrementalSurfaceInjector
		   [Generator]. Surfacing it as an analyzer dependency both lets Roslyn resolve it and makes its
		   trio injector RUN in the consumer compilation (injecting the trio exactly once). Only generator
		   packages that opt in (SyntoBundlesIncremental=true) surface it. -->
	  <TargetPathWithTargetPlatformMoniker Include="$(MSBuildProjectDirectory)\$(OutputPath)Synto.Incremental.dll"
										   Condition="'$(SyntoBundlesIncremental)' == 'true'"
										   IncludeRuntimeDependency="false"
										   MSBuildSourceProjectFile="Synto.Incremental.csproj" />

	  <!-- Synto.Template.dll carries the Template feature generator + its own TemplateSurfaceInjector
		   [Generator] (injects the Template markers). Surfacing it as an analyzer dependency both lets Roslyn
		   resolve it and makes its injector RUN in the consumer compilation. Only generator packages that opt
		   in (SyntoBundlesTemplate=true) surface it. -->
	  <TargetPathWithTargetPlatformMoniker Include="$(MSBuildProjectDirectory)\$(OutputPath)Synto.Template.dll"
										   Condition="'$(SyntoBundlesTemplate)' == 'true'"
										   IncludeRuntimeDependency="false"
										   MSBuildSourceProjectFile="Synto.Template.csproj" />
	</ItemGroup>
  </Target>

</Project>
