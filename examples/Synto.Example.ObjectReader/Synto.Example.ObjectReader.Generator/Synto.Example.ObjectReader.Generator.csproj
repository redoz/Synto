<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The SOR* descriptors are emitted by Synto.Diagnostics into generated code, which the analyzer
         release-tracking analyzer does not scan; it therefore reports the release-file entries as
         unsupported (RS2002). The AnalyzerReleases files are kept below for documentation, so RS2002 is
         suppressed for this generated-descriptor example. -->
    <NoWarn>$(NoWarn);RS2002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dog-food the single Synto umbrella: consumed as an analyzer only. Since Task 10 the umbrella bundles
         EVERY feature DLL (Template, Match, Diagnostics, …), so one reference delivers all of them — including
         Synto.Diagnostics (which injects the [Diagnostic] attribute + generates the descriptor/factory bodies)
         and Synto templating (injects the internal [Template]/Syntax<T>/Factory surface, generates
         Factory.ObjectReaderTemplate(...) from ReaderTemplate.cs). A separate Synto.Diagnostics reference would
         now double-run its generator (CS0101). No Synto.Core runtime reference — the generator consumes only the
         source generators (see architecture.md). -->
    <ProjectReference Include="..\..\..\src\Synto.Generators\Synto.Generators.csproj"
                      OutputItemType="Analyzer" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Analyzer release tracking (RS2008) for the SOR* descriptors emitted into this generator. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
