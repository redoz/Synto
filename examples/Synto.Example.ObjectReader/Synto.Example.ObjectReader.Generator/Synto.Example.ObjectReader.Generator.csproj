<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The SOR* descriptors are emitted by Synto.Diagnostics into generated code, which the analyzer
         release-tracking analyzer does not scan; it therefore reports the release-file entries as
         unsupported (RS2002). The AnalyzerReleases files are kept below for documentation, so RS2002 is
         suppressed for this generated-descriptor example. -->
    <NoWarn>$(NoWarn);RS2002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dog-food Synto.Diagnostics: consumed as an analyzer only (it injects the [Diagnostic] attribute and
         generates the descriptor + factory bodies); not a runtime dependency of this generator. -->
    <ProjectReference Include="..\..\..\src\Synto.Diagnostics\Synto.Diagnostics.csproj"
                      OutputItemType="Analyzer" PrivateAssets="all" ReferenceOutputAssembly="false" />
    <!-- Dog-food Synto templating: consumed as an analyzer only. It injects the internal [Template]/[Inline]/
         Syntax<T>/Factory surface and generates Factory.ObjectReaderTemplate(...) from ReaderTemplate.cs.
         No Synto.Core runtime reference — the generator consumes only the source generator (see architecture.md). -->
    <ProjectReference Include="..\..\..\src\Synto.Generators\Synto.Generators.csproj"
                      OutputItemType="Analyzer" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Analyzer release tracking (RS2008) for the SOR* descriptors emitted into this generator. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
